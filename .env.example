# Runtime configuration is loaded only from explicit environment variables.
RAG_AGENT_GENERATOR=local
RAG_AGENT_RETRIEVE_K=20
RAG_AGENT_RERANK_K=5
RAG_AGENT_RRF_K=60
RAG_AGENT_MIN_RERANK_SCORE=0.20
RAG_AGENT_MIN_CLAIM_SUPPORT_SCORE=0.40
RAG_AGENT_CHUNK_SIZE=384
RAG_AGENT_CHUNK_OVERLAP=48
RAG_AGENT_AGENT_MAX_ACTIONS=6
RAG_AGENT_MAX_REPAIRS=1
RAG_AGENT_MODEL_CACHE_DIR=.local/model-cache
RAG_AGENT_INDEX_DIR=.local/index
RAG_AGENT_LOCAL_MODEL_PATH=.local/model-cache/Qwen3-4B-Q5_K_M.gguf
RAG_AGENT_ALLOW_MODEL_DOWNLOAD=false
RAG_AGENT_ALLOW_NETWORK=false
RAG_AGENT_ONLINE_TIMEOUT_SECONDS=45.0

# RAG_AGENT_RELAY_API_KEY is intentionally unset. Supply it only through the
# runtime secret store after reviewing and enabling a provider profile.
